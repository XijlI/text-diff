<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Text Diff · 长文比对</title>
<style>
  :root{
    color-scheme: light;
    --bg:#f6f6f4; --card:#ffffff; --fg:#1f2328; --muted:#6a7280; --border:#e2e4e7;
    --accent:#2563eb; --accent-fg:#ffffff; --soft:#eef0f3;
    --del-bg:#fce0df; --del-fg:#a02a2e; --ins-bg:#d9f0e1; --ins-fg:#136139;
  }
  html[data-theme="dark"]{
    color-scheme: dark;
    --bg:#131519; --card:#1a1d22; --fg:#e6e9ed; --muted:#98a1ae; --border:#2a2f37;
    --accent:#5b8cff; --accent-fg:#0a1020; --soft:#22272f;
    --del-bg:#4a2024; --del-fg:#ffb1b4; --ins-bg:#173a29; --ins-fg:#8fdfb2;
  }
  *{box-sizing:border-box}
  [hidden]{display:none !important}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei UI","Microsoft YaHei",system-ui,sans-serif;
    font-size:14px; line-height:1.6; -webkit-font-smoothing:antialiased;
  }
  button{font:inherit;color:inherit;background:transparent;border:1px solid var(--border);border-radius:7px;padding:5px 11px;cursor:pointer;transition:background .15s,border-color .15s,filter .15s}
  button:hover{background:var(--soft)}
  button:active{transform:translateY(.5px)}
  button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg);font-weight:600}
  button.primary:hover{filter:brightness(1.08);background:var(--accent)}
  button.mini{padding:2px 8px;font-size:11.5px;border-radius:6px;color:var(--muted)}
  button.mini:hover{color:var(--fg)}
  button:disabled{opacity:.4;cursor:default}
  .seg{display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--card)}
  .seg button{border:0;border-radius:0;padding:5px 12px;color:var(--muted)}
  .seg button+button{border-left:1px solid var(--border)}
  .seg button.on{background:var(--soft);color:var(--fg);font-weight:600}

  header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 90%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
  .wrap{max-width:1320px;margin:0 auto;padding:0 20px}
  .row1{display:flex;align-items:center;gap:10px;height:52px}
  .brand{font-weight:700;font-size:15px;letter-spacing:.2px}
  .tag{font-size:10.5px;color:var(--muted);border:1px solid var(--border);padding:1px 7px;border-radius:999px;letter-spacing:.3px}
  .grow{flex:1}
  .row2{display:flex;flex-wrap:wrap;align-items:center;gap:14px;padding:0 0 11px}
  .row2 label{display:inline-flex;align-items:center;gap:6px;color:var(--muted);cursor:pointer;white-space:nowrap}
  .row2 label:hover{color:var(--fg)}
  .row2 input[type=checkbox]{accent-color:var(--accent);margin:0;width:14px;height:14px}

  main{padding-bottom:60px}
  .editors{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 4px}
  @media (max-width:860px){ .editors{grid-template-columns:1fr} }
  .pane{background:var(--card);border:1px solid var(--border);border-radius:10px;display:flex;flex-direction:column;overflow:hidden;transition:border-color .15s,box-shadow .15s}
  .pane.drag{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
  .pane-head{display:flex;align-items:center;gap:8px;padding:6px 8px 6px 12px;border-bottom:1px solid var(--border);font-size:12px;color:var(--muted)}
  .pane-head b{color:var(--fg);font-size:12px;font-weight:600}
  .pane textarea{
    flex:1;min-height:148px;max-height:42vh;border:0;outline:0;resize:vertical;background:transparent;color:var(--fg);
    padding:10px 13px;font:inherit;font-size:13.5px;line-height:1.72;tab-size:2;
  }
  .pane textarea::placeholder{color:var(--muted);opacity:.75}

  .stats{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding:10px 2px 12px;font-size:12.5px;color:var(--muted)}
  .stats b{color:var(--fg);font-variant-numeric:tabular-nums;font-weight:600}
  .stats .sep{width:1px;height:14px;background:var(--border)}
  .add{color:var(--ins-fg)} .rem{color:var(--del-fg)}
  .add b{color:var(--ins-fg)} .rem b{color:var(--del-fg)}
  .nav{display:inline-flex;align-items:center;gap:6px}
  .nav button{padding:2px 8px;border-radius:6px}

  .doc{
    background:var(--card);border:1px solid var(--border);border-radius:10px;padding:26px 32px;
    font-size:16.5px;line-height:1.95;white-space:pre-wrap;overflow-wrap:anywhere;
  }
  .split{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  @media (max-width:860px){ .split{grid-template-columns:1fr} }
  .split .doc{max-height:66vh;overflow:auto;padding:20px 22px;font-size:15.5px}
  .split .col-head{font-size:11.5px;color:var(--muted);padding:0 2px 6px;text-transform:uppercase;letter-spacing:.6px}

  del.c-del, .c-del{background:var(--del-bg);color:var(--del-fg);border-radius:3px;padding:0 2px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  ins.c-ins, .c-ins{background:var(--ins-bg);color:var(--ins-fg);border-radius:3px;padding:0 2px;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  .gap{display:inline-block;width:7px}
  body.strike del.c-del{text-decoration:line-through;text-decoration-thickness:1px}
  .c-del.focus,.c-ins.focus{outline:2px solid var(--accent);outline-offset:1px}

  .empty{color:var(--muted);text-align:center;padding:56px 20px;font-size:14px;line-height:2}
  .empty code{background:var(--soft);padding:1px 6px;border-radius:5px;font-size:12.5px}
  .empty .big{font-size:15px;color:var(--fg);margin-bottom:6px}

  .chg{background:var(--card);border:1px solid var(--border);border-radius:9px;padding:9px 12px;margin-bottom:8px;display:grid;grid-template-columns:30px 1fr auto;gap:10px;align-items:start}
  .chg .num{color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums;padding-top:2px;text-align:right}
  .chg .body{font-size:14.5px;line-height:1.85;overflow-wrap:anywhere}
  .chg .ctx{color:var(--muted);font-size:13px}
  .chg .line{margin-top:2px}
  .chg .mk{color:var(--muted);font-family:ui-monospace,Consolas,monospace;font-size:12px;margin-right:4px}

  #toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,14px);background:var(--fg);color:var(--bg);padding:8px 16px;border-radius:999px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .18s,transform .18s;z-index:60}
  #toast.show{opacity:1;transform:translate(-50%,0)}
  footer{color:var(--muted);font-size:12px;padding:26px 2px 10px;display:flex;gap:14px;flex-wrap:wrap;border-top:1px solid var(--border);margin-top:26px}
  kbd{font-family:ui-monospace,Consolas,monospace;font-size:11px;border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;padding:0 5px;background:var(--card)}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="row1">
      <span class="brand">Text Diff</span>
      <span class="tag">长文 / 段落级</span>
      <span class="grow"></span>
      <button id="btnSample" class="mini">载入示例</button>
      <button id="btnSwap" class="mini">交换左右</button>
      <button id="btnClear" class="mini">清空</button>
      <button id="btnTheme" class="mini" title="切换主题">自动</button>
    </div>
    <div class="row2">
      <div class="seg" id="segGran">
        <button data-g="word" class="on">词组</button>
        <button data-g="sentence">句子</button>
        <button data-g="char">字符</button>
      </div>
      <label><input type="checkbox" id="optWs" checked>忽略换行与空白</label>
      <label><input type="checkbox" id="optCase">忽略大小写</label>
      <label><input type="checkbox" id="optPunct">忽略标点</label>
      <label><input type="checkbox" id="optStrike" checked>删除线</label>
      <span class="grow"></span>
      <div class="seg" id="segView">
        <button data-v="redline" class="on">红线</button>
        <button data-v="split">并排</button>
        <button data-v="list">改动清单</button>
      </div>
      <button id="btnCompare" class="primary">比较 <kbd style="border-color:transparent;background:transparent;color:inherit;opacity:.75">Ctrl+↵</kbd></button>
    </div>
  </div>
</header>

<main>
  <div class="wrap">
    <section class="editors">
      <div class="pane" id="paneA">
        <div class="pane-head">
          <b>原文</b>
          <span class="grow"></span>
          <span id="cntA">0 字</span>
          <button class="mini" id="btnFileA">载入文件</button>
          <input type="file" id="fileA" hidden accept=".txt,.md,.markdown,.csv,.tsv,.json,.log,.xml,.html,.htm,.yaml,.yml,text/*">
        </div>
        <textarea id="taA" spellcheck="false" placeholder="把旧版本粘贴到这里，或直接把 .txt / .md 文件拖进来"></textarea>
      </div>
      <div class="pane" id="paneB">
        <div class="pane-head">
          <b>新文</b>
          <span class="grow"></span>
          <span id="cntB">0 字</span>
          <button class="mini" id="btnFileB">载入文件</button>
          <input type="file" id="fileB" hidden accept=".txt,.md,.markdown,.csv,.tsv,.json,.log,.xml,.html,.htm,.yaml,.yml,text/*">
        </div>
        <textarea id="taB" spellcheck="false" placeholder="把新版本粘贴到这里"></textarea>
      </div>
    </section>

    <section class="stats" id="stats" hidden>
      <span>字数 <b id="stA">0</b> → <b id="stB">0</b></span>
      <span class="sep"></span>
      <span class="add">新增 <b id="stAdd">0</b></span>
      <span class="rem">删除 <b id="stDel">0</b></span>
      <span>相似度 <b id="stSim">—</b></span>
      <span id="stDegraded" class="rem" hidden>差异过大，已按整块比较</span>
      <span class="sep"></span>
      <span class="nav">
        <button id="btnPrev" title="上一处 (Alt+←)">‹</button>
        <span id="navInfo">第 0 / 0 处</span>
        <button id="btnNext" title="下一处 (Alt+→)">›</button>
      </span>
      <span class="grow"></span>
      <button class="mini" id="btnCopy">复制红线</button>
      <button class="mini" id="btnCopyMd">复制 Markdown</button>
    </section>

    <section id="result">
      <div class="empty" id="emptyState">
        <div class="big">把两段文本分别粘到上面，改动会实时算出来</div>
        <div>按段落连续排布，不切行；中文按字、英文按词对齐<br>
        也可以点右上角的 <code>载入示例</code> 先看看效果</div>
      </div>
      <div id="viewRedline" hidden></div>
      <div id="viewSplit" hidden></div>
      <div id="viewList" hidden></div>
    </section>

    <footer>
      <span>离线运行 · 文本只在本机，不联网</span>
      <span><kbd>Ctrl</kbd>+<kbd>↵</kbd> 比较</span>
      <span><kbd>Alt</kbd>+<kbd>←</kbd>/<kbd>→</kbd> 上/下一处</span>
      <span>支持 .txt .md .csv .json 等纯文本文件</span>
    </footer>
  </div>
</main>

<div id="toast"></div>

<script>/*@@JSDIFF@@*/</script>
<script>
(function(){
  'use strict';

  var $ = function(id){ return document.getElementById(id); };
  var taA = $('taA'), taB = $('taB');

  var state = { gran:'word', view:'redline', ignWs:true, ignCase:false, ignPunct:false, strike:true,
                pieces:[], blocks:[], nav:-1, identical:false, degraded:false };

  /* ---------- tiny safe storage (file:// origins can throw) ---------- */
  var mem = {};
  var store = {
    get:function(k){ try { return localStorage.getItem(k); } catch(e){ return mem[k] === undefined ? null : mem[k]; } },
    set:function(k,v){ try { localStorage.setItem(k,v); } catch(e){ mem[k]=v; } }
  };

  /* ---------- helpers ---------- */
  var ESC = {'&':'&amp;','<':'&lt;','>':'&gt;'};
  function esc(s){ return String(s).replace(/[&<>]/g, function(c){ return ESC[c]; }); }
  function normText(s){ return String(s).replace(/\r\n?/g,'\n'); }
  function countChars(s){ return s.replace(/\s+/g,'').length; }

  var toastTimer;
  function toast(msg){
    var t = $('toast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 1900);
  }

  /* ---------- tokenizing: CJK-aware ---------- */
  var CJK = /^[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uac00-\ud7af]$/;
  var TOKEN_RE = /(\s+)|([A-Za-z0-9]+(?:['\u2019\-][A-Za-z0-9]+)*)|([\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uac00-\ud7af])|([\s\S])/g;

  function keyOf(type, text, o){
    if (type === 's') return o.ignWs ? 's|' : 's|' + text;
    if (type === 'w') return 'w|' + (o.ignCase ? text.toLowerCase() : text);
    if (type === 'c') return 'c|' + text;
    return 'p|' + (o.ignPunct ? '' : text);
  }

  /* With "ignore punctuation" on, punctuation is folded into the *next* token's text
     (or the last token's tail). It then takes no part in the comparison, but the
     rendered text still matches the source character for character. */
  function tokenizeWords(text, o){
    var out = [], m, buf = '';
    TOKEN_RE.lastIndex = 0;
    while ((m = TOKEN_RE.exec(text)) !== null){
      var type = m[1] !== undefined ? 's' : m[2] !== undefined ? 'w' : m[3] !== undefined ? 'c' : 'p';
      var t = m[0];
      if (type === 'p' && o.ignPunct){ buf += t; continue; }
      out.push({ text: buf + t, key: keyOf(type, t, o) });
      buf = '';
    }
    if (buf){
      if (out.length) out[out.length - 1].text += buf;
      else out.push({ text: buf, key: 'p|' + buf });
    }
    return out;
  }

  function tokenizeChars(text, o){
    var out = [], chars = Array.from(text), buf = '';
    for (var i = 0; i < chars.length; i++){
      var ch = chars[i], type;
      if (/\s/.test(ch)) type = 's';
      else if (/[A-Za-z0-9]/.test(ch)) type = 'w';
      else if (CJK.test(ch)) type = 'c';
      else type = 'p';
      if (type === 'p' && o.ignPunct){ buf += ch; continue; }
      out.push({ text: buf + ch, key: keyOf(type, ch, o) });
      buf = '';
    }
    if (buf){
      if (out.length) out[out.length - 1].text += buf;
      else out.push({ text: buf, key: 'p|' + buf });
    }
    return out;
  }

  var SENT_TERM = /[。！？!?；;\n]/;
  function splitSentences(text){
    var out = [], buf = '';
    for (var i = 0; i < text.length; i++){
      buf += text[i];
      if (SENT_TERM.test(text[i])){ out.push(buf); buf = ''; }
    }
    if (buf) out.push(buf);
    return out;
  }

  function sentenceKey(s, o){
    var k = s;
    if (o.ignWs) k = k.replace(/\s+/g, ' ');
    if (o.ignPunct) k = k.replace(/[\s。！？!?；;，,、：:""''‘’()（）\[\]【】…—\-·]/g, '');
    if (o.ignCase) k = k.toLowerCase();
    return 'S|' + k.trim();
  }

  /* ---------- diff ---------- */
  /* multiset overlap of two key arrays: 2*common/(na+nb); 1 = identical token bags */
  function similarityEstimate(ka, kb){
    var m = new Map(), i, v, c = 0;
    for (i = 0; i < ka.length; i++) m.set(ka[i], (m.get(ka[i]) || 0) + 1);
    for (i = 0; i < kb.length; i++){
      v = m.get(kb[i]);
      if (v){ m.set(kb[i], v - 1); c++; }
    }
    var t = ka.length + kb.length;
    return t ? (2 * c) / t : 1;
  }

  function joinTokens(arr){
    var s = '';
    for (var i = 0; i < arr.length; i++) s += arr[i].text;
    return s;
  }

  /* Myers is O(N*D): a 10k-char document compared against an unrelated one can hang.
     So: trim the common head/tail (cheap, always safe), diff only the middle, and if the
     middle is still too expensive, degrade to "whole block replaced" instead of freezing. */
  function diffProse(a, b, o){
    var ta, tb;
    if (o.gran === 'sentence'){
      ta = splitSentences(a).map(function(s){ return { text:s, key:sentenceKey(s, o) }; });
      tb = splitSentences(b).map(function(s){ return { text:s, key:sentenceKey(s, o) }; });
    } else if (o.gran === 'char'){
      ta = tokenizeChars(a, o); tb = tokenizeChars(b, o);
    } else {
      ta = tokenizeWords(a, o); tb = tokenizeWords(b, o);
    }

    var ka = ta.map(function(t){ return t.key; }), kb = tb.map(function(t){ return t.key; });
    var p = 0, ea = ka.length, eb = kb.length;
    while (p < ea && p < eb && ka[p] === kb[p]) p++;
    var s = 0;
    while (s < ea - p && s < eb - p && ka[ea - 1 - s] === kb[eb - 1 - s]) s++;

    var midA = ta.slice(p, ea - s), midB = tb.slice(p, eb - s);
    var pieces = [];
    if (p) pieces.push({ t:'eq', a:joinTokens(ta.slice(0, p)), b:joinTokens(tb.slice(0, p)) });

    state.degraded = false;
    var parts = [];
    if (midA.length || midB.length){
      var total = midA.length + midB.length;
      /* Cheap O(n) pre-check: if the two middles share almost no tokens at all
         (wrong file pasted, two different documents), Myers would grind for seconds
         and its output would be meaningless anyway. */
      if (total > 2000 && similarityEstimate(ka.slice(p, ea - s), kb.slice(p, eb - s)) < 0.4){
        state.degraded = true;
        parts = [{ count: midA.length, removed: true }, { count: midB.length, added: true }];
      } else {
        parts = Diff.diffArrays(
          midA.map(function(t){ return t.key; }),
          midB.map(function(t){ return t.key; }),
          { timeout: 700, maxEditLength: 12000 }
        );
        if (!parts){
          state.degraded = true;
          parts = [{ count: midA.length, removed: true }, { count: midB.length, added: true }];
        }
      }
    }

    var ia = 0, ib = 0;
    for (var i = 0; i < parts.length; i++){
      var part = parts[i], n = part.count;
      if (part.added){ pieces.push({ t:'ins', b:joinTokens(midB.slice(ib, ib + n)) }); ib += n; }
      else if (part.removed){ pieces.push({ t:'del', a:joinTokens(midA.slice(ia, ia + n)) }); ia += n; }
      else {
        pieces.push({ t:'eq', a:joinTokens(midA.slice(ia, ia + n)), b:joinTokens(midB.slice(ib, ib + n)) });
        ia += n; ib += n;
      }
    }
    if (s) pieces.push({ t:'eq', a:joinTokens(ta.slice(ea - s)), b:joinTokens(tb.slice(eb - s)) });
    return finish(pieces);
  }

  /* merge neighbours of the same type, drop empties, keep original spacing */
  function finish(pieces){
    var out = [], i, p;
    for (i = 0; i < pieces.length; i++){
      p = pieces[i];
      var txt = p.t === 'eq' ? (p.a + p.b) : (p.t === 'del' ? p.a : p.b);
      if (!txt) continue;
      var last = out[out.length - 1];
      if (last && last.t === p.t){
        if (p.t === 'eq'){ last.a += p.a; last.b += p.b; }
        else if (p.t === 'del'){ last.a += p.a; }
        else { last.b += p.b; }
      } else if (p.t === 'eq'){
        out.push({ t:'eq', a:p.a, b:p.b });
      } else if (p.t === 'del'){
        out.push({ t:'del', a:p.a });
      } else {
        out.push({ t:'ins', b:p.b });
      }
    }
    return out;
  }

  /* ---------- change blocks ---------- */
  /* A whitespace-only equality does not close a change run: "a cat" -> "a big cat"
     must count as ONE change, not two separated by the space. */
  function groupBlocks(pieces){
    var blocks = [], cur = null;
    for (var i = 0; i < pieces.length; i++){
      var p = pieces[i];
      if (p.t === 'eq'){
        if (/^\s*$/.test(p.a) || /^\s*$/.test(p.b)) continue;
        cur = null;
        continue;
      }
      if (!cur){ cur = { ci: blocks.length, del:'', ins:'', from:i }; blocks.push(cur); }
      p.ci = cur.ci;
      if (p.t === 'del') cur.del += p.a; else cur.ins += p.b;
      cur.to = i;
    }
    return blocks;
  }

  /* ---------- rendering ---------- */
  function redlineHTML(){
    var h = '', prevChange = false;
    for (var i = 0; i < state.pieces.length; i++){
      var p = state.pieces[i];
      if (p.t === 'eq'){ h += esc(p.a); prevChange = false; continue; }
      if (prevChange) h += '<span class="gap"></span>';
      prevChange = true;
      if (p.t === 'del') h += '<del class="c-del" data-ci="' + p.ci + '">' + esc(p.a) + '</del>';
      else h += '<ins class="c-ins" data-ci="' + p.ci + '">' + esc(p.b) + '</ins>';
    }
    return h;
  }

  function splitHTML(side){
    var h = '';
    for (var i = 0; i < state.pieces.length; i++){
      var p = state.pieces[i];
      if (p.t === 'eq') h += esc(side === 'a' ? p.a : p.b);
      else if (p.t === 'del' && side === 'a') h += '<span class="c-del" data-ci="' + p.ci + '">' + esc(p.a) + '</span>';
      else if (p.t === 'ins' && side === 'b') h += '<span class="c-ins" data-ci="' + p.ci + '">' + esc(p.b) + '</span>';
    }
    return h;
  }

  function snippet(s, max){
    max = max || 220;
    if (s.length <= max) return s;
    var head = Math.ceil(max * 0.6), tail = max - head;
    return s.slice(0, head) + ' … ' + s.slice(-tail);
  }

  function contextBefore(idx, len){
    for (var i = idx - 1; i >= 0; i--){
      if (state.pieces[i].t === 'eq' && /\S/.test(state.pieces[i].a)){
        var t = state.pieces[i].a.replace(/\s+/g,' ').trim();
        return t.slice(-len);
      }
    }
    return '';
  }
  function contextAfter(idx, len){
    for (var i = idx + 1; i < state.pieces.length; i++){
      if (state.pieces[i].t === 'eq' && /\S/.test(state.pieces[i].a)){
        var t = state.pieces[i].a.replace(/\s+/g,' ').trim();
        return t.slice(0, len);
      }
    }
    return '';
  }

  function listHTML(){
    var h = '';
    state.blocks.forEach(function(b, i){
      var before = contextBefore(b.from, 16), after = contextAfter(b.to, 16);
      h += '<div class="chg" data-jump="' + b.ci + '">';
      h += '<div class="num">' + (i + 1) + '</div><div class="body">';
      if (before || after) h += '<div class="ctx">…' + esc(before) + '<span style="opacity:.5"> ▌ </span>' + esc(after) + '…</div>';
      if (b.del) h += '<div class="line"><span class="mk rem">−</span><span class="c-del">' + esc(snippet(b.del)) + '</span></div>';
      if (b.ins) h += '<div class="line"><span class="mk add">+</span><span class="c-ins">' + esc(snippet(b.ins)) + '</span></div>';
      if (!b.del && !b.ins) h += '<div class="ctx">（空白变化）</div>';
      h += '</div><div><button class="mini">定位</button></div></div>';
    });
    return h || '<div class="empty">两侧完全一致，没有改动。</div>';
  }

  function emptyHTML(){
    return '<div class="big">把两段文本分别粘到上面，改动会实时算出来</div>' +
      '<div>按段落连续排布，不切行；中文按字、英文按词对齐<br>也可以点右上角的 <code>载入示例</code> 先看看效果</div>';
  }

  function renderResult(){
    var empty = !state.pieces.length || state.identical;
    $('emptyState').hidden = !empty;
    ['viewRedline','viewSplit','viewList'].forEach(function(id, i){
      var v = ['redline','split','list'][i];
      $(id).hidden = empty || state.view !== v;
    });
    if (empty){
      $('emptyState').innerHTML = state.identical
        ? '<div class="big">两边完全一致，没有发现任何差异</div>' +
          '<div>如果是同一份文件的不同排版，试试关掉「忽略换行与空白」</div>'
        : emptyHTML();
      return;
    }

    if (state.view === 'redline'){
      var el = $('viewRedline');
      el.innerHTML = '<div class="doc" id="docRedline">' + redlineHTML() + '</div>';
    } else if (state.view === 'split'){
      $('viewSplit').innerHTML =
        '<div class="split">' +
          '<div><div class="col-head">原文</div><div class="doc" id="docL">' + splitHTML('a') + '</div></div>' +
          '<div><div class="col-head">新文</div><div class="doc" id="docR">' + splitHTML('b') + '</div></div>' +
        '</div>';
      syncScroll();
    } else {
      $('viewList').innerHTML = listHTML();
      Array.prototype.forEach.call($('viewList').querySelectorAll('[data-jump]'), function(row){
        row.addEventListener('click', function(){
          switchView('redline');
          jumpTo(parseInt(row.dataset.jump, 10));
        });
      });
    }
  }

  function syncScroll(){
    var L = $('docL'), R = $('docR');
    if (!L || !R) return;
    var lock = false;
    function link(from, to){
      from.addEventListener('scroll', function(){
        if (lock) return;
        lock = true;
        var dFrom = from.scrollHeight - from.clientHeight;
        var dTo = to.scrollHeight - to.clientHeight;
        if (dFrom > 0 && dTo > 0) to.scrollTop = (from.scrollTop / dFrom) * dTo;
        else to.scrollTop = from.scrollTop;
        setTimeout(function(){ lock = false; }, 40);
      });
    }
    link(L, R); link(R, L);
  }

  function renderStats(a, b){
    var add = 0, del = 0, common = 0;
    state.pieces.forEach(function(p){
      if (p.t === 'ins') add += countChars(p.b);
      else if (p.t === 'del') del += countChars(p.a);
      else common += countChars(p.a);
    });
    var na = countChars(a), nb = countChars(b);
    var sim = (na + nb) ? Math.round(200 * common / (na + nb)) : 100;

    $('stats').hidden = false;
    $('stA').textContent = na;
    $('stB').textContent = nb;
    $('stAdd').textContent = add;
    $('stDel').textContent = del;
    $('stSim').textContent = sim + '%';
    $('stDegraded').hidden = !state.degraded;
    state.nav = -1;
    updateNav();
  }

  function updateNav(){
    var n = state.blocks.length;
    $('navInfo').textContent = n ? ('第 ' + (state.nav + 1) + ' / ' + n + ' 处') : '无改动';
    $('btnPrev').disabled = !n;
    $('btnNext').disabled = !n;
  }

  function jumpTo(ci){
    var el = document.querySelector('.c-del[data-ci="' + ci + '"], .c-ins[data-ci="' + ci + '"]');
    if (!el) return;
    state.nav = ci; updateNav();
    var all = document.querySelectorAll('.c-del.focus,.c-ins.focus');
    Array.prototype.forEach.call(all, function(x){ x.classList.remove('focus'); });
    Array.prototype.forEach.call(document.querySelectorAll('[data-ci="' + ci + '"]'), function(x){ x.classList.add('focus'); });
    el.scrollIntoView({ behavior:'smooth', block:'center' });
  }

  function step(dir){
    if (!state.blocks.length) return;
    var n = state.blocks.length;
    var next = state.nav < 0 ? (dir > 0 ? 0 : n - 1) : state.nav + dir;
    next = (next + n) % n;
    jumpTo(next);
  }

  /* ---------- compute ---------- */
  var timer = null;

  function opts(){ return { gran:state.gran, ignWs:state.ignWs, ignCase:state.ignCase, ignPunct:state.ignPunct }; }

  function schedule(immediate){
    clearTimeout(timer);
    var total = taA.value.length + taB.value.length;
    if (!immediate && total > 60000){ setHint('文本较长，按「比较」或 Ctrl+Enter 开始计算'); return; }
    timer = setTimeout(compute, immediate ? 0 : 320);
  }

  function setHint(msg){
    $('emptyState').hidden = false;
    $('emptyState').innerHTML = '<div class="big">' + esc(msg) + '</div>';
  }

  function compute(){
    var a = normText(taA.value), b = normText(taB.value);
    updateCounts();
    if (!a.trim() && !b.trim()){ resetEmpty(); persist(); return; }

    var t0 = performance.now();
    try {
      state.pieces = diffProse(a, b, opts());
    } catch (err){
      console.error(err);
      toast('计算失败：' + err.message);
      return;
    }
    state.blocks = groupBlocks(state.pieces);
    state.identical = state.pieces.every(function(p){ return p.t === 'eq'; });
    renderStats(a, b);
    renderResult();
    persist();

    var ms = performance.now() - t0;
    if (ms > 900) toast('计算完成，用时 ' + Math.round(ms) + ' ms');
  }

  function resetEmpty(){
    state.pieces = []; state.blocks = []; state.nav = -1; state.identical = false;
    $('stats').hidden = true;
    $('emptyState').hidden = false;
    $('emptyState').innerHTML = emptyHTML();
    ['viewRedline','viewSplit','viewList'].forEach(function(id){ $(id).hidden = true; });
  }

  function updateCounts(){
    $('cntA').textContent = countChars(normText(taA.value)) + ' 字';
    $('cntB').textContent = countChars(normText(taB.value)) + ' 字';
  }

  function switchView(v){
    state.view = v;
    Array.prototype.forEach.call($('segView').children, function(b){ b.classList.toggle('on', b.dataset.v === v); });
    renderResult();
    persist();
  }

  /* ---------- clipboard ---------- */
  function copyText(text, label){
    var done = function(){ toast(label || '已复制'); };
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done, function(){ fallback(); });
    } else fallback();

    function fallback(){
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed'; ta.style.top = '-1000px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch(e){ toast('复制失败，请手动选择'); }
      document.body.removeChild(ta);
    }
  }

  function redlineText(){
    return state.pieces.map(function(p){
      if (p.t === 'eq') return p.a;
      if (p.t === 'del') return '[-' + p.a + '-]';
      return '{+' + p.b + '+}';
    }).join('');
  }

  function markdownText(){
    return state.pieces.map(function(p){
      if (p.t === 'eq') return p.a;
      if (p.t === 'del') return '~~' + p.a + '~~';
      return '==' + p.b + '==';
    }).join('');
  }

  /* ---------- persistence ---------- */
  var saveTimer;
  function persist(){
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function(){
      store.set('td.a', taA.value);
      store.set('td.b', taB.value);
      store.set('td.opts', JSON.stringify({
        gran:state.gran, view:state.view, ignWs:state.ignWs,
        ignCase:state.ignCase, ignPunct:state.ignPunct, strike:state.strike
      }));
    }, 600);
  }

  /* ---------- theme ---------- */
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  function resolveTheme(){
    var pref = store.get('td.theme') || 'auto';
    var dark = pref === 'dark' || (pref === 'auto' && mq.matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    $('btnTheme').textContent = pref === 'auto' ? '自动' : (pref === 'dark' ? '深色' : '浅色');
    return pref;
  }
  function cycleTheme(){
    var pref = store.get('td.theme') || 'auto';
    var next = pref === 'auto' ? 'light' : pref === 'light' ? 'dark' : 'auto';
    store.set('td.theme', next);
    resolveTheme();
    toast('主题：' + (next === 'auto' ? '跟随系统' : next === 'light' ? '浅色' : '深色'));
  }
  if (mq.addEventListener) mq.addEventListener('change', resolveTheme);

  /* ---------- wiring ---------- */
  var SAMPLE_A =
'在项目启动阶段，我们通常会先梳理业务目标，再拆解成可以交付的里程碑。很多团队在这一步会跳过需求澄清，直接把注意力放在排期上，结果是在中期反复返工，进度反而更慢。\n\n' +
'This document explains how the reference pipeline works. Each stage writes its output to a temporary directory, and the final step publishes the artifacts to the release bucket.\n\n' +
'评审的时候，最好把「谁在什么时候确认了哪一版」记下来，否则两周之后没人说得清当时的取舍。';

  var SAMPLE_B =
'在项目启动阶段，我们通常先梳理业务目标，然后再拆解成可交付的里程碑。不少团队会跳过需求澄清这一步，直接把注意力放在排期上，结果中期反复返工，进度反而更慢。\n\n' +
'This document describes how the reference pipeline works. Every stage writes its results to a temporary folder, and the last step publishes the artifacts to the release bucket.\n\n' +
'评审时最好记下「谁在什么时候确认了哪一版」，否则两周之后没人说得清当时的取舍。新增一条：变更记录要写清原因。';

  function loadSample(){
    taA.value = SAMPLE_A; taB.value = SAMPLE_B;
    updateCounts(); compute();
    toast('已载入示例文本');
  }

  function swap(){
    var t = taA.value; taA.value = taB.value; taB.value = t;
    compute();
  }

  function clearAll(){
    if (!taA.value && !taB.value) return;
    taA.value = ''; taB.value = '';
    resetEmpty(); updateCounts(); persist();
    taA.focus();
  }

  Array.prototype.forEach.call($('segGran').children, function(btn){
    btn.addEventListener('click', function(){
      state.gran = btn.dataset.g;
      Array.prototype.forEach.call($('segGran').children, function(b){ b.classList.toggle('on', b === btn); });
      schedule(true);
    });
  });

  Array.prototype.forEach.call($('segView').children, function(btn){
    btn.addEventListener('click', function(){ switchView(btn.dataset.v); });
  });

  $('optWs').addEventListener('change', function(){ state.ignWs = this.checked; schedule(true); });
  $('optCase').addEventListener('change', function(){ state.ignCase = this.checked; schedule(true); });
  $('optPunct').addEventListener('change', function(){ state.ignPunct = this.checked; schedule(true); });
  $('optStrike').addEventListener('change', function(){
    state.strike = this.checked;
    document.body.classList.toggle('strike', state.strike);
    persist();
  });

  taA.addEventListener('input', function(){ updateCounts(); schedule(false); });
  taB.addEventListener('input', function(){ updateCounts(); schedule(false); });

  $('btnCompare').addEventListener('click', function(){ schedule(true); });
  $('btnSample').addEventListener('click', loadSample);
  $('btnSwap').addEventListener('click', swap);
  $('btnClear').addEventListener('click', clearAll);
  $('btnTheme').addEventListener('click', cycleTheme);
  $('btnPrev').addEventListener('click', function(){ step(-1); });
  $('btnNext').addEventListener('click', function(){ step(1); });
  $('btnCopy').addEventListener('click', function(){
    if (!state.pieces.length) return toast('还没有可复制的结果');
    copyText(redlineText(), '已复制红线文本');
  });
  $('btnCopyMd').addEventListener('click', function(){
    if (!state.pieces.length) return toast('还没有可复制的结果');
    copyText(markdownText(), '已复制 Markdown');
  });

  document.addEventListener('keydown', function(e){
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter'){ e.preventDefault(); schedule(true); }
    else if (e.altKey && e.key === 'ArrowLeft'){ e.preventDefault(); step(-1); }
    else if (e.altKey && e.key === 'ArrowRight'){ e.preventDefault(); step(1); }
  });

  /* file loading + drag & drop */
  function wireFile(paneId, ta, inputId, btnId){
    var input = $(inputId);
    $(btnId).addEventListener('click', function(){ input.click(); });
    input.addEventListener('change', function(){
      var f = input.files && input.files[0];
      if (!f) return;
      readInto(f, ta);
      input.value = '';
    });

    var pane = $(paneId);
    ['dragenter','dragover'].forEach(function(ev){
      pane.addEventListener(ev, function(e){ e.preventDefault(); pane.classList.add('drag'); });
    });
    ['dragleave','drop'].forEach(function(ev){
      pane.addEventListener(ev, function(e){ e.preventDefault(); pane.classList.remove('drag'); });
    });
    pane.addEventListener('drop', function(e){
      var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (f) readInto(f, ta);
    });
  }

  function readInto(file, ta){
    if (/\.(docx?|pdf)$/i.test(file.name)){
      toast('Word / PDF 请先复制正文，或用 Word 自带「比较文档」');
      return;
    }
    if (file.size > 8 * 1024 * 1024){ toast('文件太大（>8MB）'); return; }
    var r = new FileReader();
    r.onload = function(){
      ta.value = normText(String(r.result));
      updateCounts(); schedule(true);
      toast('已载入 ' + file.name);
    };
    r.onerror = function(){ toast('读取失败，可能不是纯文本文件'); };
    r.readAsText(file, 'utf-8');
  }

  wireFile('paneA', taA, 'fileA', 'btnFileA');
  wireFile('paneB', taB, 'fileB', 'btnFileB');

  /* ---------- restore ---------- */
  (function init(){
    resolveTheme();
    var saved = store.get('td.opts');
    if (saved){
      try {
        var o = JSON.parse(saved);
        if (o.gran) state.gran = o.gran;
        if (o.view) state.view = o.view;
        state.ignWs = o.ignWs !== false;
        state.ignCase = !!o.ignCase;
        state.ignPunct = !!o.ignPunct;
        state.strike = o.strike !== false;
      } catch(e){}
    }
    $('optWs').checked = state.ignWs;
    $('optCase').checked = state.ignCase;
    $('optPunct').checked = state.ignPunct;
    $('optStrike').checked = state.strike;
    document.body.classList.toggle('strike', state.strike);

    Array.prototype.forEach.call($('segGran').children, function(b){ b.classList.toggle('on', b.dataset.g === state.gran); });
    Array.prototype.forEach.call($('segView').children, function(b){ b.classList.toggle('on', b.dataset.v === state.view); });

    var a = store.get('td.a'), b = store.get('td.b');
    if (a) taA.value = a;
    if (b) taB.value = b;
    updateCounts();

    if ((taA.value || '').trim() || (taB.value || '').trim()) compute();
    else resetEmpty();
  })();

  /* test hook (harmless in normal use) */
  window.__td = {
    state:state,
    compute:compute,
    diffProse:diffProse,
    tokenizeWords:tokenizeWords,
    setTexts:function(a,b){ taA.value=a; taB.value=b; compute(); },
    setOpts:function(o){ Object.keys(o).forEach(function(k){ state[k]=o[k]; }); },
    switchView:switchView
  };
})();
</script>
</body>
</html>
